{
  "name": "trato-fino",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.mjs",
    "api:dev": "node --env-file=.env scripts/run-pnpm.mjs --dir apps/api dev",
    "cli:dev": "node --env-file=.env scripts/run-pnpm.mjs --dir apps/cli dev",
    "api:build": "node --env-file=.env scripts/run-pnpm.mjs --dir apps/api build",
    "cli:build": "node --env-file=.env scripts/run-pnpm.mjs --dir apps/cli build",
    "api:test": "node --env-file=.env scripts/run-pnpm.mjs --dir apps/api test",
    "db:generate": "node --env-file=.env scripts/run-pnpm.mjs --dir apps/api db:generate",
    "db:push": "node --env-file=.env scripts/run-pnpm.mjs --dir apps/api db:push",
    "db:seed": "node --env-file=.env scripts/run-pnpm.mjs --dir apps/api db:seed",
    "db:setup": "node --env-file=.env scripts/setup-postgres.mjs",
    "backup": "node --env-file=.env scripts/backup-postgres.mjs",
    "restore": "node --env-file=.env scripts/restore-postgres.mjs"
  }
}
