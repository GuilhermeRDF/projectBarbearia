# PostgreSQL container settings
POSTGRES_DB=trato_fino
POSTGRES_USER=trato_fino_app
POSTGRES_PASSWORD=change_me

# Database URL used by Prisma/API; keep credentials synchronized with PostgreSQL settings
DATABASE_URL=postgresql://trato_fino_app:change_me@localhost:5432/trato_fino?schema=public

# Authentication and sensitive-data cryptography (replace with strong unique secrets)
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
PII_ENCRYPTION_KEY=replace_with_existing_compatible_encryption_key
PII_BLIND_INDEX_KEY=replace_with_a_random_blind_index_key
PII_KEY_VERSION=1
PORT=3000
API_URL=http://localhost:3000
