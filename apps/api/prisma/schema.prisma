model Pagamento {
  id                    String @map("pagamento_id") @id @default(uuid())
  agendamentoId         String? @map("pagamento_agendamento_id")
  clienteId             String @map("pagamento_cliente_id")
  valor                 Decimal @map("pagamento_valor") @db.Decimal(10, 2)
  status                StatusPagamento @map("pagamento_status") @default(PENDENTE)
  metodo                String? @map("pagamento_metodo")
  provedor              String? @map("pagamento_provedor")
  idTransacaoProvedor   String? @map("pagamento_id_transacao_provedor")
  pagoEm                DateTime? @map("pagamento_pago_em")
  criadoEm              DateTime @map("pagamento_criado_em") @default(now())
  atualizadoEm          DateTime @map("pagamento_atualizado_em") @updatedAt

  agendamento Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  cliente     Usuario @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@index([clienteId])
  @@index([agendamentoId])
  @@map("pagamento")
}

model Avaliacao {
  id            String @map("avaliacao_id") @id @default(uuid())
  agendamentoId String @map("avaliacao_agendamento_id") @unique
  clienteId     String @map("avaliacao_cliente_id")
  barbeiroId    String @map("avaliacao_barbeiro_id")
  nota          Int @map("avaliacao_nota")
  comentario    String? @map("avaliacao_comentario")
  criadoEm      DateTime @map("avaliacao_criado_em") @default(now())

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  cliente     Usuario @relation("ClienteAvaliacao", fields: [clienteId], references: [id], onDelete: Restrict)
  barbeiro    PerfilFuncionario @relation(fields: [barbeiroId], references: [id], onDelete: Restrict)

  @@index([clienteId])
  @@index([barbeiroId])
  @@map("avaliacao")
}

model Comanda {
  id            String @map("comanda_id")   @id @default(uuid())
  barbeariaId   String @map("comanda_barbearia_id")
  usuarioId     String @map("comanda_usuario_id")
  agendamentoId String? @map("comanda_agendamento_id") @unique
  valorTotal    Decimal @map("comanda_valor_total")  @default(0) @db.Decimal(10, 2)
  status        StatusComanda @map("comanda_status") @default(ABERTA)
  formaPagto    String? @map("comanda_forma_pagto")
  criadoEm      DateTime @map("comanda_criado_em") @default(now())

  barbearia     Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  usuario       Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  itens         ItemComanda[]

  @@index([barbeariaId])
  @@map("comanda")
}

model ItemComanda {
  id         String @map("item_comanda_id") @id @default(uuid())
  comandaId  String @map("item_comanda_comanda_id")
  servicoId  String? @map("item_comanda_servico_id")
  barbeiroId String? @map("item_comanda_barbeiro_id")
  preco      Decimal @map("item_comanda_preco") @db.Decimal(10, 2)
  comissao   Decimal @map("item_comanda_comissao") @db.Decimal(10, 2)

  comanda    Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  servico    Servico? @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  barbeiro   PerfilFuncionario? @relation(fields: [barbeiroId], references: [id], onDelete: SetNull)
  @@map("item_comanda")
}
