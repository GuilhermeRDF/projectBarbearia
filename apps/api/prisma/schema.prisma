datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleUsuario {
  ADMIN
  CLIENTE
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
  NAO_COMPARECEU
}

enum StatusComanda {
  ABERTA
  PAGA
  CANCELADA
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  ESTORNADO
  CANCELADO
}

model Barbearia {
  id           String @map("barbearia_id")   @id @default(uuid())
  nome         String @map("barbearia_nome")
  slug         String @map("barbearia_slug")   @unique
  telefone     String? @map("barbearia_telefone")
  endereco     String? @map("barbearia_endereco")
  logoUrl      String? @map("barbearia_logo_url")
  criadoEm     DateTime @map("barbearia_criado_em") @default(now())

  usuarios     Usuario[]
  servicos     Servico[]
  barbeiros    PerfilFuncionario[]
  agendamentos Agendamento[]
  comandas     Comanda[]
  @@map("barbearia")
}

model Usuario {
  id                    String @map("usuario_id")   @id @default(uuid())
  barbeariaId           String? @map("usuario_barbearia_id")
  role                  RoleUsuario @map("usuario_role") @default(CLIENTE)
  estaAtivo             Boolean @map("usuario_esta_ativo")  @default(true)
  eEquipe               Boolean @map("usuario_e_equipe")  @default(false)
  eSuperusuario         Boolean @map("usuario_e_superusuario")  @default(false)
  quantidadeFalhasLogin Int @map("usuario_quantidade_falhas_login")      @default(0)
  bloqueadoAte          DateTime? @map("usuario_bloqueado_ate")
  senhaAlteradaEm       DateTime? @map("usuario_senha_alterada_em")
  ultimoLoginEm         DateTime? @map("usuario_ultimo_login_em")
  excluidoEm            DateTime? @map("usuario_excluido_em")
  anonimizadoEm         DateTime? @map("usuario_anonimizado_em")
  criadoEm              DateTime @map("usuario_criado_em") @default(now())
  atualizadoEm          DateTime @map("usuario_atualizado_em") @updatedAt

  barbearia             Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: SetNull)
  credencial            CredencialUsuario?
  dadosPessoais         DadosPessoaisUsuario?
  perfis                UsuarioPerfil[]
  perfisAtribuidos      UsuarioPerfil[] @relation("AtribuidorPerfil")
  perfilCliente         PerfilCliente?
  perfilFuncionario     PerfilFuncionario?
  sessoes               SessaoAutenticacao[]
  tokensRedefinicao     TokenRedefinicaoSenha[]
  tentativasLogin       TentativaLogin[]
  agendamentosCliente   Agendamento[] @relation("ClienteAgendamento")
  agendamentosCriados   Agendamento[] @relation("CriadorAgendamento")
  observacoes           ObservacaoAgendamento[]
  notificacoes          Notificacao[]
  logsAtor               LogAuditoria[] @relation("AtorAuditoria")
  logsTitular            LogAcessoDadoSensivel[] @relation("TitularDadoSensivel")
  logsAcessoAtor         LogAcessoDadoSensivel[] @relation("AtorDadoSensivel")
  consentimentos         ConsentimentoPrivacidade[]
  solicitacoes           SolicitacaoPrivacidade[] @relation("TitularSolicitacao")
  solicitacoesTratadas   SolicitacaoPrivacidade[] @relation("TratadorSolicitacao")
  pagamentos             Pagamento[]
  avaliacoesCliente      Avaliacao[] @relation("ClienteAvaliacao")
  historicosAlterados    HistoricoAgendamento[] @relation("AlteradoPorHistorico")
  bloqueiosCriados       BloqueioAgenda[] @relation("CriadorBloqueio")
  comandas               Comanda[]

  @@index([barbeariaId])
  @@index([estaAtivo])
  @@map("usuario")
}

model CredencialUsuario {
  id              String @map("credencial_usuario_id")   @id @default(uuid())
  usuarioId       String @map("credencial_usuario_usuario_id")   @unique
  hashSenha       String @map("credencial_usuario_hash_senha")
  versaoSenha     Int @map("credencial_usuario_versao_senha")      @default(1)
  mfaHabilitado   Boolean @map("credencial_usuario_mfa_habilitado")  @default(false)
  senhaTemporaria Boolean @map("credencial_usuario_senha_temporaria")  @default(false)
  criadoEm        DateTime @map("credencial_usuario_criado_em") @default(now())
  atualizadoEm    DateTime @map("credencial_usuario_atualizado_em") @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@map("credencial_usuario")
}

model DadosPessoaisUsuario {
  id                       String @map("dados_pessoais_usuario_id")   @id @default(uuid())
  usuarioId                String @map("dados_pessoais_usuario_usuario_id")   @unique
  nomeCompletoCriptografado String @map("dados_pessoais_usuario_nome_completo_criptografado")
  cpfCriptografado         String @map("dados_pessoais_usuario_cpf_criptografado")
  hashBuscaCpf             String @map("dados_pessoais_usuario_hash_busca_cpf")   @unique
  emailCriptografado       String @map("dados_pessoais_usuario_email_criptografado")
  hashBuscaEmail           String @map("dados_pessoais_usuario_hash_busca_email")   @unique
  telefoneCriptografado    String? @map("dados_pessoais_usuario_telefone_criptografado")
  hashBuscaTelefone        String? @map("dados_pessoais_usuario_hash_busca_telefone")
  versaoChaveCriptografia  Int @map("dados_pessoais_usuario_versao_chave_criptografia")      @default(1)
  criadoEm                 DateTime @map("dados_pessoais_usuario_criado_em") @default(now())
  atualizadoEm             DateTime @map("dados_pessoais_usuario_atualizado_em") @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@map("dados_pessoais_usuario")
}

model PerfilAcesso {
  id          String @map("perfil_acesso_id") @id @default(uuid())
  codigo      String @map("perfil_acesso_codigo") @unique
  nome        String @map("perfil_acesso_nome")
  descricao   String? @map("perfil_acesso_descricao")
  eSistema    Boolean @map("perfil_acesso_e_sistema") @default(true)
  usuarios    UsuarioPerfil[]
  permissoes  PerfilPermissao[]
  @@map("perfil_acesso")
}

model Permissao {
  id          String @map("permissao_id") @id @default(uuid())
  codigo      String @map("permissao_codigo") @unique
  descricao   String? @map("permissao_descricao")
  perfis      PerfilPermissao[]
  @@map("permissao")
}

model UsuarioPerfil {
  id          String @map("usuario_perfil_id")   @id @default(uuid())
  usuarioId   String @map("usuario_perfil_usuario_id")
  perfilId    String @map("usuario_perfil_perfil_id")
  atribuidoPor String? @map("usuario_perfil_atribuido_por")
  atribuidoEm DateTime @map("usuario_perfil_atribuido_em") @default(now())

  usuario      Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  perfil       PerfilAcesso @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  atribuidor   Usuario? @relation("AtribuidorPerfil", fields: [atribuidoPor], references: [id], onDelete: SetNull)

  @@unique([usuarioId, perfilId])
  @@index([usuarioId])
  @@index([perfilId])
  @@map("usuario_perfil")
}

model PerfilPermissao {
  id          String @map("perfil_permissao_id") @id @default(uuid())
  perfilId    String @map("perfil_permissao_perfil_id")
  permissaoId String @map("perfil_permissao_permissao_id")

  perfil      PerfilAcesso @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissao   Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([perfilId, permissaoId])
  @@map("perfil_permissao")
}

model PerfilCliente {
  id                    String @map("perfil_cliente_id") @id @default(uuid())
  usuarioId             String @map("perfil_cliente_usuario_id") @unique
  observacoesOperacionais String? @map("perfil_cliente_observacoes_operacionais")
  criadoEm              DateTime @map("perfil_cliente_criado_em") @default(now())
  atualizadoEm          DateTime @map("perfil_cliente_atualizado_em") @updatedAt
  usuario               Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@map("perfil_cliente")
}

model PerfilFuncionario {
  id                    String @map("perfil_funcionario_id") @id @default(uuid())
  usuarioId             String @map("perfil_funcionario_usuario_id") @unique
  barbeariaId           String @map("perfil_funcionario_barbearia_id")
  nomeExibicao          String? @map("perfil_funcionario_nome_exibicao")
  bio                   String? @map("perfil_funcionario_bio")
  urlFoto               String? @map("perfil_funcionario_url_foto")
  dataAdmissao          DateTime? @map("perfil_funcionario_data_admissao")
  estaDisponivel        Boolean @map("perfil_funcionario_esta_disponivel") @default(true)
  especialidade         String? @map("perfil_funcionario_especialidade")
  horarioInicio         String @map("perfil_funcionario_horario_inicio") @default("08:00")
  horarioFim            String @map("perfil_funcionario_horario_fim") @default("18:00")
  inicioAlmoco          String? @map("perfil_funcionario_inicio_almoco")
  fimAlmoco             String? @map("perfil_funcionario_fim_almoco")
  comissaoPorcent       Decimal @map("perfil_funcionario_comissao_porcent") @default(30) @db.Decimal(5, 2)
  criadoEm              DateTime @map("perfil_funcionario_criado_em") @default(now())
  atualizadoEm          DateTime @map("perfil_funcionario_atualizado_em") @updatedAt

  usuario               Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  barbearia             Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  servicos              ServicoBarbeiro[]
  horarios              HorarioTrabalho[]
  bloqueios             BloqueioAgenda[]
  agendamentos          Agendamento[]
  itensComanda          ItemComanda[]
  avaliacoes            Avaliacao[]
  historicosBarbeiroAnterior HistoricoAgendamento[] @relation("BarbeiroAnterior")
  historicosBarbeiroNovo HistoricoAgendamento[] @relation("BarbeiroNovo")

  @@index([barbeariaId])
  @@map("perfil_funcionario")
}

model SessaoAutenticacao {
  id                String @map("sessao_autenticacao_id")   @id @default(uuid())
  usuarioId         String @map("sessao_autenticacao_usuario_id")
  hashToken         String @map("sessao_autenticacao_hash_token")   @unique
  hashIdDispositivo String? @map("sessao_autenticacao_hash_id_dispositivo")
  enderecoIp        String? @map("sessao_autenticacao_endereco_ip")
  agenteUsuario     String? @map("sessao_autenticacao_agente_usuario")
  emitidoEm         DateTime @map("sessao_autenticacao_emitido_em") @default(now())
  expiraEm          DateTime @map("sessao_autenticacao_expira_em")
  revogadoEm        DateTime? @map("sessao_autenticacao_revogado_em")
  motivoRevogacao   String? @map("sessao_autenticacao_motivo_revogacao")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessao_autenticacao")
}

model TokenRedefinicaoSenha {
  id             String @map("token_redefinicao_senha_id")   @id @default(uuid())
  usuarioId      String @map("token_redefinicao_senha_usuario_id")
  hashToken      String @map("token_redefinicao_senha_hash_token")   @unique
  expiraEm       DateTime @map("token_redefinicao_senha_expira_em")
  usadoEm        DateTime? @map("token_redefinicao_senha_usado_em")
  ipSolicitacao  String? @map("token_redefinicao_senha_ip_solicitacao")
  criadoEm       DateTime @map("token_redefinicao_senha_criado_em") @default(now())
  usuario        Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("token_redefinicao_senha")
}

model TentativaLogin {
  id                    String @map("tentativa_login_id")   @id @default(uuid())
  usuarioId             String? @map("tentativa_login_usuario_id")
  hashBuscaIdentificador String @map("tentativa_login_hash_busca_identificador")
  foiBemSucedida        Boolean @map("tentativa_login_foi_bem_sucedida")
  enderecoIp            String? @map("tentativa_login_endereco_ip")
  agenteUsuario         String? @map("tentativa_login_agente_usuario")
  criadoEm              DateTime @map("tentativa_login_criado_em") @default(now())
  usuario               Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([hashBuscaIdentificador])
  @@index([criadoEm])
  @@map("tentativa_login")
}

model Servico {
  id             String @map("servico_id")   @id @default(uuid())
  barbeariaId    String @map("servico_barbearia_id")
  nome           String @map("servico_nome")
  descricao      String? @map("servico_descricao")
  preco          Decimal @map("servico_preco")  @db.Decimal(10, 2)
  duracaoMinutos Int @map("servico_duracao_minutos")
  estaAtivo      Boolean @map("servico_esta_ativo") @default(true)
  criadoEm       DateTime @map("servico_criado_em") @default(now())
  atualizadoEm   DateTime @map("servico_atualizado_em") @updatedAt

  barbearia      Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeiros      ServicoBarbeiro[]
  agendamentos   Agendamento[]
  servicosAgenda ServicoAgendamento[]
  itensComanda   ItemComanda[]

  @@index([estaAtivo])
  @@index([nome])
  @@index([barbeariaId])
  @@map("servico")
}

model ServicoBarbeiro {
  id                       String @map("servico_barbeiro_id") @id @default(uuid())
  barbeiroId               String @map("servico_barbeiro_barbeiro_id")
  servicoId                String @map("servico_barbeiro_servico_id")
  precoPersonalizado       Decimal? @map("servico_barbeiro_preco_personalizado") @db.Decimal(10, 2)
  duracaoPersonalizadaMinutos Int? @map("servico_barbeiro_duracao_personalizada_minutos")
  estaAtivo                Boolean @map("servico_barbeiro_esta_ativo") @default(true)

  barbeiro PerfilFuncionario @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)
  servico  Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([barbeiroId, servicoId])
  @@map("servico_barbeiro")
}

model HorarioTrabalho {
  id           String @map("horario_trabalho_id") @id @default(uuid())
  barbeiroId   String @map("horario_trabalho_barbeiro_id")
  diaSemana    Int @map("horario_trabalho_dia_semana")
  horaInicio   String @map("horario_trabalho_hora_inicio")
  horaFim      String @map("horario_trabalho_hora_fim")
  validoDesde  DateTime? @map("horario_trabalho_valido_desde")
  validoAte    DateTime? @map("horario_trabalho_valido_ate")
  estaAtivo    Boolean @map("horario_trabalho_esta_ativo") @default(true)
  barbeiro     PerfilFuncionario @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)

  @@index([barbeiroId, diaSemana])
  @@map("horario_trabalho")
}

model BloqueioAgenda {
  id          String @map("bloqueio_agenda_id") @id @default(uuid())
  barbeiroId  String @map("bloqueio_agenda_barbeiro_id")
  inicioEm    DateTime @map("bloqueio_agenda_inicio_em")
  fimEm       DateTime @map("bloqueio_agenda_fim_em")
  motivo      String? @map("bloqueio_agenda_motivo")
  criadoPor   String @map("bloqueio_agenda_criado_por")
  criadoEm    DateTime @map("bloqueio_agenda_criado_em") @default(now())
  barbeiro    PerfilFuncionario @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)
  criador     Usuario @relation("CriadorBloqueio", fields: [criadoPor], references: [id], onDelete: Restrict)

  @@index([barbeiroId, inicioEm, fimEm])
  @@map("bloqueio_agenda")
}

model Agendamento {
  id                 String @map("agendamento_id") @id @default(uuid())
  barbeariaId        String @map("agendamento_barbearia_id")
  codigoConfirmacao  String @map("agendamento_codigo_confirmacao") @unique @default(uuid())
  usuarioId          String @map("agendamento_usuario_id")
  barbeiroId         String @map("agendamento_barbeiro_id")
  servicoId          String @map("agendamento_servico_id")
  inicioAgendado     DateTime @map("agendamento_inicio_agendado")
  fimAgendado        DateTime @map("agendamento_fim_agendado")
  status             StatusAgendamento @map("agendamento_status") @default(PENDENTE)
  origem             String @map("agendamento_origem") @default("TERMINAL")
  criadoPor          String @map("agendamento_criado_por")
  confirmadoEm       DateTime? @map("agendamento_confirmado_em")
  canceladoEm        DateTime? @map("agendamento_cancelado_em")
  motivoCancelamento String? @map("agendamento_motivo_cancelamento")
  observacaoLegado   String? @map("agendamento_observacao_legado")
  versaoRegistro     Int @map("agendamento_versao_registro") @default(1)
  criadoEm           DateTime @map("agendamento_criado_em") @default(now())
  atualizadoEm       DateTime @map("agendamento_atualizado_em") @updatedAt

  barbearia          Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  usuario            Usuario @relation("ClienteAgendamento", fields: [usuarioId], references: [id], onDelete: Restrict)
  barbeiro           PerfilFuncionario @relation(fields: [barbeiroId], references: [id], onDelete: Restrict)
  servico            Servico @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  criador             Usuario @relation("CriadorAgendamento", fields: [criadoPor], references: [id], onDelete: Restrict)
  servicos           ServicoAgendamento[]
  historico          HistoricoAgendamento[]
  observacoes        ObservacaoAgendamento[]
  notificacoes       Notificacao[]
  pagamentos         Pagamento[]
  avaliacao          Avaliacao?
  comanda            Comanda?

  @@index([barbeariaId])
  @@index([usuarioId])
  @@index([barbeiroId])
  @@index([status])
  @@index([inicioAgendado])
  @@index([barbeiroId, inicioAgendado, fimAgendado])
  @@map("agendamento")
}

model ServicoAgendamento {
  id              String @map("servico_agendamento_id") @id @default(uuid())
  agendamentoId   String @map("servico_agendamento_agendamento_id")
  servicoId       String @map("servico_agendamento_servico_id")
  preco           Decimal @map("servico_agendamento_preco") @db.Decimal(10, 2)
  duracaoMinutos  Int @map("servico_agendamento_duracao_minutos")

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  servico     Servico @relation(fields: [servicoId], references: [id], onDelete: Restrict)

  @@unique([agendamentoId, servicoId])
  @@map("servico_agendamento")
}

model HistoricoAgendamento {
  id                 String @map("historico_agendamento_id") @id @default(uuid())
  agendamentoId      String @map("historico_agendamento_agendamento_id")
  alteradoPor        String @map("historico_agendamento_alterado_por")
  acao               String @map("historico_agendamento_acao")
  inicioAnterior     DateTime? @map("historico_agendamento_inicio_anterior")
  novoInicio         DateTime? @map("historico_agendamento_novo_inicio")
  barbeiroAnteriorId String? @map("historico_agendamento_barbeiro_anterior_id")
  novoBarbeiroId     String? @map("historico_agendamento_novo_barbeiro_id")
  statusAnterior     String? @map("historico_agendamento_status_anterior")
  novoStatus         String? @map("historico_agendamento_novo_status")
  motivo             String? @map("historico_agendamento_motivo")
  criadoEm           DateTime @map("historico_agendamento_criado_em") @default(now())

  agendamento         Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  alteradoPorUsuario  Usuario @relation("AlteradoPorHistorico", fields: [alteradoPor], references: [id], onDelete: Restrict)
  barbeiroAnterior    PerfilFuncionario? @relation("BarbeiroAnterior", fields: [barbeiroAnteriorId], references: [id], onDelete: SetNull)
  barbeiroNovo        PerfilFuncionario? @relation("BarbeiroNovo", fields: [novoBarbeiroId], references: [id], onDelete: SetNull)

  @@index([agendamentoId])
  @@index([criadoEm])
  @@map("historico_agendamento")
}

model ObservacaoAgendamento {
  id                       String @map("observacao_agendamento_id") @id @default(uuid())
  agendamentoId            String @map("observacao_agendamento_agendamento_id")
  autorId                  String @map("observacao_agendamento_autor_id")
  observacaoCriptografada  String @map("observacao_agendamento_observacao_criptografada")
  versaoChaveCriptografia  Int @map("observacao_agendamento_versao_chave_criptografia") @default(1)
  criadoEm                 DateTime @map("observacao_agendamento_criado_em") @default(now())

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  autor       Usuario @relation(fields: [autorId], references: [id], onDelete: Restrict)
  @@map("observacao_agendamento")
}

model Notificacao {
  id                       String @map("notificacao_id") @id @default(uuid())
  usuarioId                String @map("notificacao_usuario_id")
  agendamentoId            String? @map("notificacao_agendamento_id")
  canal                    String @map("notificacao_canal")
  tipo                     String @map("notificacao_tipo")
  provedor                 String? @map("notificacao_provedor")
  idMensagemProvedor       String? @map("notificacao_id_mensagem_provedor")
  status                   String @map("notificacao_status") @default("PENDENTE")
  conteudoCriptografado    String? @map("notificacao_conteudo_criptografado")
  respostaCriptografada    String? @map("notificacao_resposta_criptografada")
  versaoChaveCriptografia  Int @map("notificacao_versao_chave_criptografia") @default(1)
  enviadoEm                DateTime? @map("notificacao_enviado_em")
  entregueEm               DateTime? @map("notificacao_entregue_em")
  lidoEm                   DateTime? @map("notificacao_lido_em")
  falhouEm                 DateTime? @map("notificacao_falhou_em")
  respondidoEm             DateTime? @map("notificacao_respondido_em")
  criadoEm                 DateTime @map("notificacao_criado_em") @default(now())

  usuario      Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  agendamento  Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([agendamentoId])
  @@index([status])
  @@index([criadoEm])
  @@map("notificacao")
}

model LogAuditoria {
  id                 String @map("log_auditoria_id") @id @default(uuid())
  usuarioAtorId      String? @map("log_auditoria_usuario_ator_id")
  tipoEvento         String @map("log_auditoria_tipo_evento")
  tipoEntidade       String @map("log_auditoria_tipo_entidade")
  entidadeId         String? @map("log_auditoria_entidade_id")
  resultado          String @map("log_auditoria_resultado")
  enderecoIp         String? @map("log_auditoria_endereco_ip")
  agenteUsuario      String? @map("log_auditoria_agente_usuario")
  requisicaoId       String? @map("log_auditoria_requisicao_id")
  metadados          String? @map("log_auditoria_metadados")
  hashEventoAnterior String? @map("log_auditoria_hash_evento_anterior")
  hashEvento         String? @map("log_auditoria_hash_evento")
  criadoEm           DateTime @map("log_auditoria_criado_em") @default(now())

  ator Usuario? @relation("AtorAuditoria", fields: [usuarioAtorId], references: [id], onDelete: SetNull)

  @@index([usuarioAtorId])
  @@index([tipoEntidade])
  @@index([entidadeId])
  @@index([tipoEvento])
  @@index([criadoEm])
  @@index([requisicaoId])
  @@map("log_auditoria")
