  diasRetencao           Int? @map("politica_retencao_dados_dias_retencao")
  baseLegal              String? @map("politica_retencao_dados_base_legal")
  anonimizarAposExpiracao Boolean @map("politica_retencao_dados_anonimizar_apos_expiracao") @default(true)
  descricao              String? @map("politica_retencao_dados_descricao")
  atualizadoEm           DateTime @map("politica_retencao_dados_atualizado_em") @updatedAt
  @@map("politica_retencao_dados")
