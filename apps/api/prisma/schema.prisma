model SolicitacaoPrivacidade {
  id           String @map("solicitacao_privacidade_id") @id @default(uuid())
  usuarioId    String @map("solicitacao_privacidade_usuario_id")
  tipo         String @map("solicitacao_privacidade_tipo")
  status       String @map("solicitacao_privacidade_status") @default("ABERTA")
  abertoEm     DateTime @map("solicitacao_privacidade_aberto_em") @default(now())
  prazoEm      DateTime? @map("solicitacao_privacidade_prazo_em")
  concluidoEm  DateTime? @map("solicitacao_privacidade_concluido_em")
  tratadoPor   String? @map("solicitacao_privacidade_tratado_por")
  observacoes  String? @map("solicitacao_privacidade_observacoes")

